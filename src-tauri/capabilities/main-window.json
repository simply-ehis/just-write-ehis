{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Main-window application commands, updater, and process controls.",
  "windows": ["main"],
  "permissions": [
    "main",
    "allow-tabs-get",
    "allow-tabs-set",
    "updater:default",
    "process:default",
    "autostart:default",
    "core:window:allow-set-size",
    "core:window:allow-set-position"
  ]
}
