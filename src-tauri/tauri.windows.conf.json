{
  "build": {
    "beforeBuildCommand": "npm run build && npm run build:sidecars"
  },
  "bundle": {
    "resources": [
      "sidecars/fetch_sidecars.py",
      "sidecars/requirements.txt",
      "sidecars/stt_server.py",
      "sidecars/tts_server.py",
      "sidecars/memory_server.py",
      "sidecars/harness/*",
      "sidecars/models/**/*",
      "sidecars/bin/**/*"
    ],
    "fileAssociations": [
      {
        "ext": ["txt", "text", "rtf", "log"],
        "description": "Plain text document"
      },
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mkdn", "mdwn"],
        "description": "Markdown document"
      },
      {
        "ext": ["rst", "org", "adoc", "asciidoc"],
        "description": "reStructuredText / Org-mode / AsciiDoc document"
      },
      {
        "ext": ["json", "yaml", "yml", "toml", "ini", "cfg", "conf", "xml", "csv", "tsv"],
        "description": "Configuration or data file"
      },
      {
        "ext": ["html", "htm", "css", "js", "ts", "jsx", "tsx"],
        "description": "Web or script file"
      },
      {
        "ext": ["py", "rs", "go", "java", "c", "cpp", "h", "hpp", "cs", "php", "rb", "swift", "kt", "scala"],
        "description": "Source code file"
      },
      {
        "ext": ["sh", "bash", "zsh", "ps1", "bat", "cmd"],
        "description": "Shell script"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
