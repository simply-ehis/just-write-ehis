{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Just Write ehis",
  "version": "0.2.1",
  "identifier": "com.just-write-ehis.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Just Write ehis",
        "width": 1240,
        "height": 740,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "resizable": true
      },
      {
        "label": "widget",
        "title": "Just Write ehis Companion",
        "url": "index.html?widget=1",
        "width": 56,
        "height": 56,
        "minWidth": 48,
        "minHeight": 48,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' http://127.0.0.1:* http://localhost:* https://* ipc: http://ipc.localhost; img-src 'self' data: blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "simply-ehis",
    "homepage": "https://github.com/simply-ehis/just-write-ehis",
    "copyright": "Copyright (C) 2026 simply-ehis",
    "shortDescription": "Just Write ehis — a personal super app for writing and everything around writing",
    "targets": "nsis",
    "externalBin": ["binaries/pandoc"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer-assets/header.bmp",
        "sidebarImage": "installer-assets/sidebar.bmp"
      }
    },
    "resources": [
      "sidecars/fetch_sidecars.py",
      "sidecars/requirements.txt",
      "sidecars/stt_server.py",
      "sidecars/tts_server.py",
      "sidecars/memory_server.py",
      "sidecars/harness/*",
      "sidecars/models/**/*"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDMjg3NUZCMkNDNDA0MEUKUldRT0JNUXMrM1VvSE1qUzBWUWV5dXNJVjdxWitLdFd4S3hRcHVKTWhOWlovTWhtMnZ2Q2o2bWUK",
      "endpoints": [
        "https://github.com/simply-ehis/just-write-ehis/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
