{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Just Write ehis",
  "version": "0.2.1",
  "identifier": "com.just-write-ehis.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Just Write ehis",
        "width": 1240,
        "height": 740,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "resizable": true,
        "visible": false
      },
      {
        "label": "widget",
        "title": "Just Write ehis Companion",
        "url": "index.html?widget=1",
        "width": 56,
        "height": 56,
        "minWidth": 48,
        "minHeight": 48,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "resizable": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' http://127.0.0.1:8090 http://127.0.0.1:8091 http://127.0.0.1:8092 http://127.0.0.1:8093 https://api.anthropic.com https://api.openai.com https://api.groq.com https://api.deepseek.com https://openrouter.ai https://nominatim.openstreetmap.org https://api.open-meteo.com ipc: http://ipc.localhost; img-src 'self' data: blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "simply-ehis",
    "homepage": "https://github.com/simply-ehis/just-write-ehis#readme",
    "copyright": "Copyright (C) 2026 simply-ehis",
    "shortDescription": "A personal super app for writing and everything around writing",
    "longDescription": "Just Write ehis is a local-first desktop writing application built with Tauri 2 and Svelte 5. It provides a distraction-free writing environment with integrated AI features, voice input/output, document management, and knowledge organization tools.",
    "targets": "nsis",
    "externalBin": ["binaries/typst"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer-assets/header.bmp",
        "sidebarImage": "installer-assets/sidebar.bmp"
      }
    },
    "resources": [
      "../THIRD_PARTY_NOTICES.md",
      "sidecars/fetch_sidecars.py",
      "sidecars/requirements.txt",
      "sidecars/stt_server.py",
      "sidecars/tts_server.py",
      "sidecars/memory_server.py",
      "sidecars/harness/*",
      "sidecars/models/**/*"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGRjA4NjYyNUVFRDg2NDYKUldSR2h1MWVZb2J3UDJuNTB5RTZ4UU9PMDQxOGdLc0dVRmw1ZFM2TWtrQ09Pbmg4S09WU0lOcFAK",
      "endpoints": [
        "https://github.com/simply-ehis/just-write-ehis/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
