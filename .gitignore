# Deps & build outputs
node_modules/
dist/
src-tauri/target/

# Fetched sidecar models/binaries (hundreds of MB, re-fetchable).
# Keep the README so fresh clones know how to populate this dir.
src-tauri/sidecars/models/*
!src-tauri/sidecars/models/README.md
src-tauri/sidecars/bin/*
src-tauri/sidecars/.runtime-build-*

# Bundled pandoc sidecar (233 MB for 3.11 Windows — fetched, not committed).
# Release builds need it: see docs/EXPORT.md "Bundling pandoc as a sidecar".
src-tauri/binaries/*

# Python caches
__pycache__/
*.pyc
*.pyo

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local logs
*.log
just-write-ehis.key
just-write-ehis.key.password

# Patchi local config
.patchi/
.patchi/.env
.patchi/keys.json
.vercel
