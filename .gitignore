# Deps & build outputs
node_modules/
dist/
src-tauri/target/

# Fetched sidecar models/binaries (hundreds of MB, re-fetchable).
# Keep the README so fresh clones know how to populate this dir.
src-tauri/sidecars/models/*
!src-tauri/sidecars/models/README.md
src-tauri/sidecars/bin/*
src-tauri/sidecars/.runtime-build-*

# Bundled Typst CLI (21 MB for 0.15.1 Windows — fetched, not committed).
# PDF export needs it; md/txt/html/docx/epub are pure Rust and do not.
# Fetch with `python src-tauri/sidecars/fetch_sidecars.py --typst`
# See docs/EXPORT.md "Bundling Typst as a sidecar".
src-tauri/binaries/*

# Python caches
__pycache__/
*.pyc
*.pyo

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local logs
*.log
# Updater signing identity: private key + password never enter git in any
# shape. The PUBLIC key (*.key.pub) is tracked intentionally for endpoint
# verification; see docs/UPDATES.md (env-only signing) for rotation notes.
*.key
*.key.password
!*.key.pub

# Patchi local config
.patchi/
.patchi/.env
.patchi/keys.json
.vercel
